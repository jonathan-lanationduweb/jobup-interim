# Cache navigateur — hébergement Apache d'interimjobup.com
# Les CSS et JS portent un paramètre ?v= : on change sa valeur à chaque mise à jour,
# un cache long est donc sans risque. Les pages HTML restent en cache court.
# Attention : les images et les polices n'ont pas de ?v= ; pour en remplacer une,
# lui donner un nouveau nom de fichier.

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 10 minutes"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|png|jpe?g|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Script de maintenance du dépôt : inutile en ligne.
<FilesMatch "\.py$">
  Require all denied
</FilesMatch>
